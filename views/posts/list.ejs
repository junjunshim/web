<div class="my-5">
    <h1 class="text-center mb-5">게시글</h1>
    <div class="text-end mb-2">
        <button class="btn btn-outline-primary px-5 btn-insert mb-3">글쓰기</button>
        <form name="frm" class="input-group mb-3">
            <input type="text" name="word" class="form-control" placeholder="검색어 입력" aria-label="검색어 입력" aria-describedby="button-addon2">
            <button class="btn btn-primary" type="submit" id="button-addon2">검색</button>
        </form>
    </div>
    <table id="tbl" class="table table-striped table-hover"></table>
    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page" class="mx-3"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>
    <script id="temp_posts" type="text/x-handlebars-template">
        <tbody>
            {{#each .}}
                <tr>
                    <td>{{ID}}</td>
                    <td><a href="/posts/{{ID}}" class="link-dark">{{TITLE}}</a></td>  
                    <td>{{SNAME}}({{WRITER}})</td>
                    <td class="text-end">{{FMT_DATE}}</td>
                </tr>
            {{/each}}
        </tbody>
    </script>
</div>
<script>
    var page = 1;
    var size = 5;
    var word = "";
    var last = 0;

    getList();

    $(".btn-insert").on("click", function () {
        if (scode) {
            location.href = '/posts/insert';
        }
        else {
            sessionStorage.setItem("target", "/posts/insert");
            location.href = '/users/login';
        }
    });

    $(frm).on('submit', function(e){
        e.preventDefault();

        word = $(frm.word).val();

        page = 1;

        getList();
    });

    $("#next").on("click", function () {
        if(page == last){
            return;
        }
        page++;
        getList();
    });

    $("#prev").on("click", function () {
        if(page == 1){
            return;
        }
        page--;
        getList();
    });

    function getList() {
        console.log(page, size);
        $.ajax({
            type: "get",
            url: "/posts/list.json",
            data: { page, size, word},
            success: function (data) {
                console.log(data);
                
                const temp = Handlebars.compile($("#temp_posts").html());
                $("#tbl").html(temp(data.list));

                const last = Math.ceil(parseInt(data.total) / size);
                $("#page").html(`${page}/${last}`);

                //1페이지에서 이전 버튼을 클릭한 경우
                if (page == 1) $("#prev").attr("disabled", true);
                else $("#prev").attr("disabled", false);

                //마지막 페에지에서 다음 버튼을 클릭한 경우
                if (page == last) $("#next").attr("disabled", true);
                else $("#next").attr("disabled", false);
            }
        })
    }
</script>